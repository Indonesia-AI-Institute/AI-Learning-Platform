# =====================================
# APP METADATA
# =====================================
APP_NAME=AI Learning Platform Backend API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# =====================================
# SERVER (FastAPI / Uvicorn)
# =====================================
HOST=0.0.0.0
PORT=8000

# =====================================
# LLM PROVIDER SELECTION
# Pilih salah satu: openai | openrouter | gemini | anthropic | custom
# =====================================
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048
DEFAULT_TIMEOUT=60

# =====================================
# OPENAI
# =====================================
OPENAI_API_KEY=sk-or-xxx
OPENAI_API_BASE=https://api.openai.com/v1

# =====================================
# OPENROUTER
# Model format: "openai/gpt-4o", "anthropic/claude-3-5-sonnet", "meta-llama/llama-3.1-8b-instruct:free"
# https://openrouter.ai/models
# =====================================
# DEFAULT_LLM_PROVIDER=openrouter
# DEFAULT_LLM_MODEL=openai/gpt-4o
# OPENROUTER_API_KEY=sk-or-xxx

# =====================================
# GEMINI (via OpenAI-compatible endpoint)
# Model format: "gemini-2.0-flash", "gemini-1.5-pro"
# https://ai.google.dev/gemini-api/docs
# =====================================
# DEFAULT_LLM_PROVIDER=gemini
# DEFAULT_LLM_MODEL=gemini-2.0-flash
# GEMINI_API_KEY=AIza-xxx

# =====================================
# ANTHROPIC (Native SDK)
# Uncomment dan set DEFAULT_LLM_PROVIDER=anthropic untuk menggunakan
# Requires: pip install anthropic
# Model format: "claude-3-5-sonnet-20241022", "claude-3-haiku-20240307"
# https://docs.anthropic.com/en/docs/models-overview
# =====================================
# DEFAULT_LLM_PROVIDER=anthropic
# DEFAULT_LLM_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=sk-ant-xxx

# =====================================
# CUSTOM PROVIDER (Ollama, LM Studio, self-hosted OpenAI-compatible)
# =====================================
# DEFAULT_LLM_PROVIDER=custom
# DEFAULT_LLM_MODEL=llama3.2
# CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
# CUSTOM_LLM_API_KEY=ollama

# =====================================
# STREAMING (SSE CONFIG)
# =====================================
STREAM_TIMEOUT_SECONDS=60
STREAM_KEEP_ALIVE=true

# =====================================
# SECURITY
# =====================================
SECRET_KEY=your-secret-key-here

# =====================================
# CORS
# =====================================
CORS_ORIGINS=["http://localhost:3000"]

# =====================================
# LOGGING
# =====================================
LOG_LEVEL=INFO

# =====================================
# FEATURE FLAGS
# =====================================
ENABLE_STREAMING=true
ENABLE_RAG=false
ENABLE_WEBSEARCH=false