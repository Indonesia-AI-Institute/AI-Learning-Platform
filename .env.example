# =====================================
# APP METADATA
# =====================================
APP_NAME="AI Learning Platform Backend API"
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# =====================================
# DATABASE (PostgreSQL)
# =====================================
DATABASE_URL=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# =====================================
# SERVER (FastAPI / Uvicorn)
# =====================================
HOST=0.0.0.0
PORT=8000

# =====================================
# LLM DEFAULT CONFIG
# =====================================
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=gpt-40
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048
DEFAULT_TIMEOUT=60

# =====================================
# OPENAI
# =====================================
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
OPENAI_API_BASE=https://api.openai.com/v1

# =====================================
# OPENROUTER
# =====================================
#OPENROUTER_API_KEY=<YOUR_OPENROUTER_API_KEY>
#OPENROUTER_PROVIDER_ORDER=DeepInfra,SiliconFlow
#OPENROUTER_ALLOW_FALLBACKS=true
#OPENROUTER_REQUIRE_PROVIDER=false

# =====================================
# GEMINI
# =====================================
#GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# =====================================
# ANTHROPIC
# =====================================
#ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>

# =====================================
# CUSTOM PROVIDER
# =====================================
#CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
#CUSTOM_LLM_API_KEY=<YOUR_CUSTOM_API_KEY>

# =====================================
# STREAMING (SSE CONFIG)
# =====================================
#STREAM_TIMEOUT_SECONDS=60
#STREAM_KEEP_ALIVE=true

# =====================================
# SECURITY
# =====================================
#SECRET_KEY=<YOUR_SECRET_KEY>

# =====================================
# CORS
# =====================================
CORS_ORIGINS=["http://localhost:3000"]

# =====================================
# LOGGING
# =====================================
LOG_LEVEL=INFO

# =====================================
# FEATURE FLAGS
# =====================================
#ENABLE_STREAMING=true
#ENABLE_RAG=false
#ENABLE_WEBSEARCH=false