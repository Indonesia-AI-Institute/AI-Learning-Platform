# =====================================
# APP METADATA
# =====================================
APP_NAME=AI Learning Platform
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# =====================================
# PostgreSQL
# =====================================
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=ai_learning
POSTGRES_PORT=5432
POSTGRES_HOST=db # Sesuaikan dengan nama service database di docker

# =====================================
# DATABASE URL
# =====================================
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# =====================================
# SERVER (FastAPI / Uvicorn)
# =====================================
HOST=0.0.0.0
PORT=8000

# =====================================
# LLM DEFAULT CONFIG
# =====================================
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=gpt-40
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048
DEFAULT_TIMEOUT=60

# =====================================
# OPENAI
# =====================================
#OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
#OPENAI_API_BASE=https://api.openai.com/v1

# =====================================
# OPENROUTER
# =====================================
# PROVIDER ROUTING — pilih infrastruktur untuk model
# Contoh provider: DeepInfra, SiliconFlow, Chutes, Together, Fireworks
# Kosongkan OPENROUTER_PROVIDER_ORDER untuk auto-select
# ======================================
OPENROUTER_API_KEY=<YOUR_OPENROUTER_API_KEY>
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_PROVIDER_ORDER=
OPENROUTER_ALLOW_FALLBACKS=true
OPENROUTER_REQUIRE_PROVIDER=false

# =====================================
# GEMINI
# =====================================
#GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# =====================================
# ANTHROPIC
# =====================================
#ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>

# =====================================
# CUSTOM PROVIDER
# =====================================
#CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
#CUSTOM_LLM_API_KEY=<YOUR_CUSTOM_API_KEY>

# =====================================
# STREAMING (SSE CONFIG)
# =====================================
STREAM_TIMEOUT_SECONDS=60
STREAM_KEEP_ALIVE=true

# =====================================
# SECURITY
# =====================================
SECRET_KEY=<YOUR_SECRET_KEY>

# =====================================
# CORS
# =====================================
CORS_ORIGINS=["http://localhost:3000"]

# =====================================
# PUBLIC URL (untuk frontend)
# =====================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# =====================================
# LOGGING
# =====================================
LOG_LEVEL=INFO

# =====================================
# FEATURE FLAGS
# =====================================
ENABLE_STREAMING=true
ENABLE_RAG=false
ENABLE_WEBSEARCH=false