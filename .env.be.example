# Backend environment — copy to .env.be and fill in values.
# Consumed by src/backend (see src/backend/core/config.py) and by the
# `db`/`api` services in docker-compose*.yml.

# App metadata
APP_NAME=AI Learning Platform
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=ai_learning
POSTGRES_PORT=5432
POSTGRES_HOST=db # service name of the database container

# Database URL, built from the POSTGRES_* values above
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Server (FastAPI / Uvicorn)
HOST=0.0.0.0
PORT=8000

# LLM default config
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=gpt-4o
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048
DEFAULT_TIMEOUT=60

# OpenAI
#OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
#OPENAI_API_BASE=https://api.openai.com/v1

# OpenRouter — pick the infrastructure a model runs on, e.g. DeepInfra,
# SiliconFlow, Chutes, Together, Fireworks. Leave OPENROUTER_PROVIDER_ORDER
# empty to auto-select.
OPENROUTER_API_KEY=<YOUR_OPENROUTER_API_KEY>
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_PROVIDER_ORDER=
OPENROUTER_ALLOW_FALLBACKS=true
OPENROUTER_REQUIRE_PROVIDER=false

# Gemini
#GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# Anthropic
#ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>

# Custom provider
#CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
#CUSTOM_LLM_API_KEY=<YOUR_CUSTOM_API_KEY>

# Streaming (SSE)
STREAM_TIMEOUT_SECONDS=60
STREAM_KEEP_ALIVE=true
ENABLE_STREAMING=true

# Security
SECRET_KEY=<YOUR_SECRET_KEY>

# CORS — origins allowed to call the API (the frontend's URL)
CORS_ORIGINS=["http://localhost:3000"]

# Logging
LOG_LEVEL=INFO

# Feature flags
ENABLE_RAG=false
ENABLE_WEBSEARCH=false
