# Frontend environment — copy to .env.fe and fill in values.
# Consumed by src/frontend (see src/frontend/src/lib/env.ts and entrypoint.sh),
# which reads NEXT_PUBLIC_API_URL at container start and exposes it to the
# browser via window.__ENV__.

# Public URL of the backend API
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Port the server listens on inside the container (optional, defaults to
# 3000 if unset). If you change this, update the container side of the
# "ports:" mapping in docker-compose*.yml to match.
#PORT=3000

# There is deliberately no HOSTNAME variable here: Docker/Linux auto-sets
# HOSTNAME to the container ID before entrypoint.sh runs, so it's
# force-set to 0.0.0.0 there rather than left user-configurable — see the
# comment in src/frontend/entrypoint.sh for why.
