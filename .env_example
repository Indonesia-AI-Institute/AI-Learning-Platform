# =====================================
# APP METADATA
# =====================================
APP_NAME=AI Learning Platform Backend API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# =====================================
# SERVER (FastAPI / Uvicorn)
# =====================================
HOST=0.0.0.0
PORT=8000

# =====================================
# OPENAI (CORE CHAT + STREAMING)
# =====================================
OPENAI_PROVIDER=openai
OPENAI_API_KEY=sk-xxxxxxx
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2048
OPENAI_API_BASE=https://api.openai.com/v1
# =====================================
# STREAMING (SSE CONFIG)
# =====================================
STREAM_TIMEOUT_SECONDS=60
STREAM_KEEP_ALIVE=true

# =====================================
# LOGGING
# =====================================
LOG_LEVEL=INFO

# =====================================
# DATABASE (Future Proof - kalau nanti aktif)
# =====================================
# DATABASE_URL=postgresql://user:password@localhost:5432/deeptutor

# =====================================
# FEATURE FLAGS (Optional - buat scaling nanti)
# =====================================
ENABLE_STREAMING=true
ENABLE_RAG=false
ENABLE_WEBSEARCH=false